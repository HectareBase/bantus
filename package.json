{
  "name": "bantus-root",
  "private": true,
  "description": "Runs the app/ scripts from the repository root",
  "scripts": {
    "setup": "npm --prefix app install",
    "start": "npm --prefix app start --",
    "debug": "npm --prefix app run debug --",
    "screenshots": "npm --prefix app run screenshots --",
    "icons": "npm --prefix app run icons --",
    "test": "npm --prefix app test --",
    "typecheck": "npm --prefix app run typecheck --"
  }
}
