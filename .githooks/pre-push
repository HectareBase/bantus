#!/bin/sh
# 送ろうとしているコミットに、個人のメールアドレスや公開してはいけない内容が残っていないか調べる。
# コミットの日時はそのまま公開する（書き換えない）。

root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000

# このリポジトリ専用の名前とメールアドレスが設定されていること（グローバルの設定を使わない）
local_email=$(git config --local user.email)
if [ -z "$local_email" ] || [ -z "$(git config --local user.name)" ]; then
  echo "[pre-push] このリポジトリ専用の user.name と user.email が設定されていません（docs/publishing.md）。" >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi

  bad=$(git log --format='%h|%an|%ae|%cn|%ce' "$range" |
    awk -F'|' -v email="$local_email" '$3 != email || $5 != email')
  if [ -n "$bad" ]; then
    echo "[pre-push] このリポジトリ専用のメールアドレスで作られていないコミットがあります:" >&2
    printf '%s\n' "$bad" | sed 's/^/    /' >&2
    echo "[pre-push] .githooks/fix-commit-author.sh で直してから、もう一度 push してください。" >&2
    status=1
  fi
done

# 追跡しているファイル全体も念のため調べる
"$root/.githooks/check-private.sh" --all || status=1
exit $status
