<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude セッション" Width="460" Height="560"
        Topmost="True" WindowStyle="ToolWindow" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Background="#FAFAFA"
        FontFamily="Yu Gothic UI" FontSize="13">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="8">
      <Button x:Name="QuitButton" DockPanel.Dock="Right" Content="終了" Padding="10,2" Margin="6,0,0,0"
              ToolTip="ショートカットごと終了します"/>
      <TextBox x:Name="SearchBox" Padding="4" ToolTip="タイトルまたはフォルダ名で絞り込み"/>
    </DockPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="8,4" Foreground="#6B7280" FontSize="11"
               Text="クリックまたは Enter で開く / Esc で隠す"/>
    <ListBox x:Name="SessionList" BorderThickness="0" Background="Transparent"
             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3" ToolTip="{Binding Detail}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5"/>
              <ColumnDefinition Width="22"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{Binding Color}" CornerRadius="2"/>
            <TextBlock Grid.Column="1" Text="{Binding Mark}" Foreground="{Binding MarkColor}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Folder, Mode=OneWay}"/>
                <Run Text="  "/>
                <Run Text="{Binding When, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
